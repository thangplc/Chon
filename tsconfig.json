{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["apps", "node_modules", "prototype"]
}
