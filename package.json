{
  "name": "chon-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-stack.mjs",
    "dev:web": "pnpm --filter @chon/web dev",
    "dev:api": "pnpm --filter @chon/api dev",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "pnpm --filter @chon/web build",
    "build:api": "pnpm --filter @chon/api build",
    "start:web": "pnpm --filter @chon/web start",
    "start:api": "pnpm --filter @chon/api start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:web": "pnpm --filter @chon/web typecheck",
    "typecheck:api": "pnpm --filter @chon/api typecheck",
    "test": "pnpm test:packages && pnpm test:web && pnpm test:api",
    "test:packages": "vitest run --config vitest.config.ts",
    "test:web": "pnpm --filter @chon/web test",
    "test:api": "pnpm --filter @chon/api test",
    "data:import": "pnpm --filter @chon/api data:import",
    "data:verify": "pnpm --filter @chon/api data:verify",
    "editorial:collections:import": "pnpm --filter @chon/api editorial:collections:import",
    "metadata:synthetic:import": "pnpm --filter @chon/api metadata:synthetic:import",
    "service-areas:sync": "pnpm --filter @chon/api service-areas:sync",
    "service-areas:import": "pnpm --filter @chon/api service-areas:import",
    "service-areas:verify": "pnpm --filter @chon/api service-areas:verify",
    "spatial:verify": "pnpm --filter @chon/api spatial:verify",
    "provider:status": "pnpm --filter @chon/api provider:status",
    "provider:vibe:normalize": "pnpm --filter @chon/api provider:vibe:normalize",
    "vietmap:poi:spike": "pnpm --filter @chon/api vietmap:poi:spike",
    "vietmap:poi:sync": "pnpm --filter @chon/api vietmap:poi:sync",
    "osm:opening-hours:sync": "pnpm --filter @chon/api osm:opening-hours:sync",
    "provider:credentials:check": "pnpm --filter @chon/api provider:credentials:check",
    "provider:credentials:gate": "pnpm --filter @chon/api provider:credentials:gate",
    "vibe:snapshots:rebuild": "pnpm --filter @chon/api vibe:snapshots:rebuild",
    "db:check": "pnpm --filter @chon/api db:check",
    "db:down": "pnpm --filter @chon/api db:down",
    "db:generate": "pnpm --filter @chon/api db:generate",
    "db:logs": "pnpm --filter @chon/api db:logs",
    "db:migrate": "pnpm --filter @chon/api db:migrate",
    "db:verify": "pnpm --filter @chon/api db:verify",
    "db:studio": "pnpm --filter @chon/api db:studio",
    "db:up": "pnpm --filter @chon/api db:up"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
