{
  "name": "chon-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "api:build": "pnpm --filter @chon/api build",
    "api:dev": "pnpm --filter @chon/api dev",
    "api:test": "pnpm --filter @chon/api test",
    "api:typecheck": "pnpm --filter @chon/api typecheck",
    "web:build": "pnpm --filter @chon/web build",
    "web:dev": "pnpm --filter @chon/web dev",
    "web:test": "pnpm --filter @chon/web test",
    "web:typecheck": "pnpm --filter @chon/web typecheck",
    "build": "pnpm web:build",
    "build:all": "pnpm web:build && pnpm api:build",
    "dev": "pnpm web:dev",
    "dev:stack": "node scripts/dev-stack.mjs",
    "env:split": "node scripts/split-environment-files.mjs",
    "start": "pnpm --filter @chon/web start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm web:typecheck && pnpm api:typecheck",
    "test": "pnpm test:packages && pnpm web:test && pnpm api:test",
    "test:packages": "vitest run --config vitest.config.ts",
    "test:web": "pnpm web:test",
    "test:watch": "vitest",
    "data:import": "pnpm --filter @chon/api data:import",
    "data:verify": "pnpm --filter @chon/api data:verify",
    "service-areas:sync": "pnpm --filter @chon/api service-areas:sync",
    "service-areas:import": "pnpm --filter @chon/api service-areas:import",
    "service-areas:verify": "pnpm --filter @chon/api service-areas:verify",
    "spatial:verify": "pnpm --filter @chon/api spatial:verify",
    "provider:status": "pnpm --filter @chon/api provider:status",
    "provider:credentials:check": "pnpm --filter @chon/api provider:credentials:check",
    "provider:credentials:gate": "pnpm --filter @chon/api provider:credentials:gate",
    "db:check": "pnpm --filter @chon/api db:check",
    "db:down": "pnpm --filter @chon/api db:down",
    "db:generate": "pnpm --filter @chon/api db:generate",
    "db:logs": "pnpm --filter @chon/api db:logs",
    "db:migrate": "pnpm --filter @chon/api db:migrate",
    "db:verify": "pnpm --filter @chon/api db:verify",
    "db:studio": "pnpm --filter @chon/api db:studio",
    "db:up": "pnpm --filter @chon/api db:up"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
