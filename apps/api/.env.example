# Local PostgreSQL/PostGIS
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=chon
DATABASE_USER=chon
DATABASE_PASSWORD=replace_with_a_local_password
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# NestJS backend. Local defaults are shown; production must set all three.
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# Server-only assertion shared by Next.js auth proxy and NestJS API.
# Generate a unique value with: openssl rand -base64 48
AUTH_API_SECRET=dev-only-change-this-auth-api-secret-32chars
AUTH_API_ISSUER=chon-web
AUTH_API_AUDIENCE=chon-api

# Authenticated community contribution abuse limits.
VIBE_REPORT_LIMIT_10_MINUTES=3
VIBE_REPORT_LIMIT_24_HOURS=10
VIBE_REPORT_PLACE_COOLDOWN_MINUTES=360

# Must match --environment for every non-dry-run data import.
DATA_IMPORT_TARGET_ENVIRONMENT=local

# Local/staging Explore rollout. Keep false until real POI import is verified.
EXPLORE_INCLUDE_REAL_PLACES=false
# synthetic | mixed | real. Set real after real POIs are imported and verified.
EXPLORE_PLACE_DATA_MODE=synthetic
# synthetic | mixed | real. Synthetic overlays are local/staging-only demo facts.
EXPLORE_PLACE_METADATA_MODE=synthetic

# Optional actor identifier recorded by data operator scripts.
DATA_OPERATOR_ID=local-developer

# Provider vibe feature flags (fail-closed; every flag defaults to false).
THIRD_PARTY_VIBE_ENABLED=false

FOURSQUARE_VIBE_INGEST_ENABLED=false
FOURSQUARE_VIBE_RANKING_ENABLED=false
FOURSQUARE_VIBE_PRODUCTION_READY=false

GOOGLE_VIBE_INGEST_ENABLED=false
GOOGLE_VIBE_RANKING_ENABLED=false
GOOGLE_VIBE_PRODUCTION_READY=false

YELP_VIBE_INGEST_ENABLED=false
YELP_VIBE_RANKING_ENABLED=false
YELP_VIBE_PRODUCTION_READY=false

TRIPADVISOR_VIBE_INGEST_ENABLED=false
TRIPADVISOR_VIBE_RANKING_ENABLED=false
TRIPADVISOR_VIBE_PRODUCTION_READY=false

# VIETMAP POI ingestion (server-side only; feature-flagged and guarded).
VIETMAP_POI_ENABLED=false
VIETMAP_API_KEY=
VIETMAP_POI_BASE_URL=https://maps.vietmap.vn/api/search/v4
VIETMAP_POI_PLACE_BASE_URL=https://maps.vietmap.vn/api/place/v4
VIETMAP_POI_REVERSE_BASE_URL=https://maps.vietmap.vn/api/reverse/v4
VIETMAP_POI_CATEGORY_CAFE=1001-1
VIETMAP_POI_QUERY_TEXT=cafe
VIETMAP_POI_TIMEOUT_MS=5000
VIETMAP_POI_REQUEST_INTERVAL_MS=500
VIETMAP_POI_MAX_REQUESTS=200
VIETMAP_POI_PRODUCTION_READY=false

# OSM opening-hours enrichment (Overpass; no API key, fail-closed).
# Set the flag only when running the explicit sync command. Use a descriptive
# User-Agent and keep the public Overpass request guard conservative.
OSM_OPENING_HOURS_ENABLED=false
OSM_OPENING_HOURS_PRODUCTION_READY=false
OSM_OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
OSM_USER_AGENT=Chon/0.1 (OSM opening-hours enrichment; contact@example.invalid)
OSM_OPENING_HOURS_BATCH_SIZE=20
OSM_OPENING_HOURS_MAX_REQUESTS=10
OSM_OPENING_HOURS_RADIUS_METERS=100
OSM_OPENING_HOURS_TIMEOUT_MS=15000

# Provider credentials (server-side only; required only when ingest is enabled).
FOURSQUARE_PLACES_TOKEN=
GOOGLE_PLACES_API_KEY=
YELP_PLACES_API_KEY=
TRIPADVISOR_CONTENT_API_KEY=
