{
  "name": "@chon/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "data:import": "node --import tsx scripts/data-import.ts",
    "data:verify": "node --import tsx scripts/verify-data-import.ts",
    "metadata:synthetic:import": "node --import tsx scripts/import-synthetic-place-metadata.ts",
    "db:check": "drizzle-kit check",
    "db:down": "docker compose --file compose.yaml --env-file .env down",
    "db:generate": "drizzle-kit generate",
    "db:logs": "docker compose --file compose.yaml --env-file .env logs --follow postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose --file compose.yaml --env-file .env up --detach postgres",
    "db:verify": "node scripts/verify-core-schema.mjs",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --config ../../eslint.config.mjs",
    "provider:credentials:check": "node --import tsx scripts/provider-vibe-status.ts",
    "provider:credentials:gate": "node --import tsx scripts/provider-vibe-status.ts --require-all",
    "provider:status": "node --import tsx scripts/provider-vibe-status.ts",
    "provider:vibe:normalize": "node --import tsx scripts/provider-vibe-normalize.ts",
    "osm:opening-hours:sync": "node --import tsx scripts/osm-opening-hours-sync.ts",
    "vietmap:poi:spike": "node --import tsx scripts/vietmap-poi-spike.ts",
    "vietmap:poi:sync": "node --import tsx scripts/vietmap-poi-sync.ts",
    "vibe:snapshots:rebuild": "node --import tsx scripts/rebuild-vibe-snapshots.ts",
    "service-areas:import": "node --import tsx scripts/import-service-area-boundaries.ts",
    "service-areas:sync": "node --import tsx scripts/sync-service-area-boundaries.ts",
    "service-areas:verify": "node --import tsx scripts/verify-service-area-coverage.ts",
    "spatial:verify": "node --import tsx scripts/verify-spatial-place-query.ts",
    "start": "node dist/apps/api/src/main.js",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json"
  },
  "dependencies": {
    "@chon/domain": "workspace:*",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
