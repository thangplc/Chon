# Server-only URL used by Next.js SSR and same-origin API proxy.
BACKEND_API_URL=http://127.0.0.1:3001
BACKEND_API_TIMEOUT_MS=5000

# Auth.js server-only configuration.
AUTH_SECRET=generate-a-long-random-secret
AUTH_TRUST_HOST=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must match apps/api/.env; never expose as NEXT_PUBLIC_*.
AUTH_API_SECRET=dev-only-change-this-auth-api-secret-32chars
AUTH_API_ISSUER=chon-web
AUTH_API_AUDIENCE=chon-api

# Public browser key: restrict allowed origins in MapTiler Cloud.
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_MAPTILER_STYLE_ID=streets-v4
